#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
IMAGE="${AUDIO_TRANSCRIBE_IMAGE:-audio-transcribe:latest}"

usage() {
  cat <<'EOF'
Usage: audio-transcribe [options] <audio> [output]

Transcribe an audio file with Vosk.

Options:
  -f, --format FORMAT   txt (default), srt, json
  -o, --output PATH     Output transcript file
  -m, --model PATH      Vosk model directory
  -h, --help            Show this help

Examples:
  audio-transcribe lecture.mp3
  audio-transcribe clip.wav transcript.txt
  audio-transcribe interview.m4a -f srt
EOF
}

die() {
  echo "audio-transcribe: $1" >&2
  exit 1
}

abspath() {
  local path="$1"
  local dir
  dir="$(cd "$(dirname "$path")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    die "docker is not installed"
  fi

  if docker info >/dev/null 2>&1; then
    return 0
  fi

  die "docker is not running"
}

ensure_image() {
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    return 0
  fi

  echo "audio-transcribe: building $IMAGE..." >&2
  docker build -t "$IMAGE" "$SKILL_DIR"
}

INPUT=""
OUTPUT=""
MODEL=""
PASSTHRU=()

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--format)
      [ $# -ge 2 ] || die "missing value for $1"
      PASSTHRU+=("$1" "$2")
      shift 2
      ;;
    -o|--output)
      [ $# -ge 2 ] || die "missing value for $1"
      OUTPUT="$2"
      shift 2
      ;;
    -m|--model)
      [ $# -ge 2 ] || die "missing value for $1"
      MODEL="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      if [ -z "$INPUT" ]; then
        INPUT="$1"
      elif [ -z "$OUTPUT" ]; then
        OUTPUT="$1"
      else
        die "unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

[ -n "$INPUT" ] || { usage >&2; exit 1; }
[ -f "$INPUT" ] || die "file not found: $INPUT"

ensure_docker
ensure_image

INPUT_ABS="$(abspath "$INPUT")"
INPUT_DIR="$(dirname "$INPUT_ABS")"
OUTPUT_DIR="$INPUT_DIR"
MODEL_DIR=""

if [ -n "$OUTPUT" ]; then
  OUTPUT_PARENT="$(dirname "$OUTPUT")"
  mkdir -p "$OUTPUT_PARENT"
  OUTPUT_ABS="$(abspath "$OUTPUT")"
  OUTPUT_DIR="$(dirname "$OUTPUT_ABS")"
fi

if [ -n "$MODEL" ]; then
  [ -d "$MODEL" ] || die "model not found: $MODEL"
  MODEL_ABS="$(cd "$MODEL" && pwd)"
  MODEL_DIR="$(dirname "$MODEL_ABS")"
fi

DOCKER_ARGS=(
  run --rm
  -e "HOST_INPUT_DIR=$INPUT_DIR"
  -e "HOST_OUTPUT_DIR=$OUTPUT_DIR"
  -v "$INPUT_DIR:/in"
)

CONTAINER_INPUT="/in/$(basename "$INPUT_ABS")"
CONTAINER_OUTPUT=""
CONTAINER_MODEL=""

if [ "$OUTPUT_DIR" != "$INPUT_DIR" ]; then
  DOCKER_ARGS+=(-v "$OUTPUT_DIR:/out")
  if [ -n "${OUTPUT_ABS:-}" ]; then
    CONTAINER_OUTPUT="/out/$(basename "$OUTPUT_ABS")"
  fi
elif [ -n "${OUTPUT_ABS:-}" ]; then
  CONTAINER_OUTPUT="/in/$(basename "$OUTPUT_ABS")"
fi

if [ -n "$MODEL_DIR" ]; then
  if [ "$MODEL_DIR" = "$INPUT_DIR" ]; then
    CONTAINER_MODEL="/in/$(basename "$MODEL_ABS")"
  elif [ "$MODEL_DIR" = "$OUTPUT_DIR" ]; then
    CONTAINER_MODEL="/out/$(basename "$MODEL_ABS")"
  else
    DOCKER_ARGS+=(-v "$MODEL_DIR:/model")
    CONTAINER_MODEL="/model/$(basename "$MODEL_ABS")"
  fi
fi

CMD=("${DOCKER_ARGS[@]}" "$IMAGE")
CMD+=("${PASSTHRU[@]+"${PASSTHRU[@]}"}")
if [ -n "$CONTAINER_MODEL" ]; then
  CMD+=(-m "$CONTAINER_MODEL")
fi
CMD+=("$CONTAINER_INPUT")
if [ -n "$CONTAINER_OUTPUT" ]; then
  CMD+=("$CONTAINER_OUTPUT")
fi

exec docker "${CMD[@]}"
